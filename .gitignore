.netlify
node_modules/
__pycache__/
*.pyc
*.bak
*.tmp
*.log
scratch_test/
live_*.png
test_*.png
test_*.txt

# The repo root is the public web root: keep one-off scripts and screenshots out of it.
# Operational scripts go in scripts/, tests in tests/ (both blocked by the nginx snippet).
/*.sh
/*.py
/fix_*
/check_*
/test_*
/screenshot_*

# Large AI model files are deployed separately (not stored in git)
models/*.onnx
models/*.ok

# Admin credentials and the session signing key exist only on the server
backend/data/auth.json
backend/data/secret.key
